{
  "attribute_rules": {
    "artist": {
      "kwargs": {
        "sources": [
          "discogs"
        ]
      },
      "resolver": "favour_sources"
    },
    "duration": {
      "kwargs": {},
      "resolver": "median"
    },
    "genre": {
      "kwargs": {},
      "resolver": "most_complete"
    },
    "label": {
      "kwargs": {},
      "resolver": "most_complete"
    },
    "name": {
      "kwargs": {
        "sources": [
          "musicbrainz"
        ]
      },
      "resolver": "favour_sources"
    },
    "release-country": {
      "kwargs": {},
      "resolver": "voting"
    },
    "release-date": {
      "kwargs": {},
      "resolver": "earliest"
    },
    "tracks": {
      "kwargs": {
        "sources": [
          "musicbrainz"
        ]
      },
      "resolver": "favour_sources"
    }
  }
}