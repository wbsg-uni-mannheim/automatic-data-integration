{
  "attribute_rules": {
    "artist": {
      "kwargs": {
        "trust_key": "trust_score"
      },
      "resolver": "weighted_voting"
    },
    "duration": {
      "kwargs": {},
      "resolver": "median"
    },
    "genre": {
      "kwargs": {
        "sources": [
          "discogs"
        ]
      },
      "resolver": "favour_sources"
    },
    "label": {
      "kwargs": {
        "sources": [
          "discogs"
        ]
      },
      "resolver": "favour_sources"
    },
    "name": {
      "kwargs": {
        "sources": [
          "musicbrainz"
        ]
      },
      "resolver": "favour_sources"
    },
    "release-country": {
      "kwargs": {
        "trust_key": "trust_score"
      },
      "resolver": "weighted_voting"
    },
    "release-date": {
      "kwargs": {
        "trust_key": "trust_score"
      },
      "resolver": "weighted_voting"
    },
    "tracks": {
      "kwargs": {
        "separator": ","
      },
      "resolver": "union"
    }
  }
}