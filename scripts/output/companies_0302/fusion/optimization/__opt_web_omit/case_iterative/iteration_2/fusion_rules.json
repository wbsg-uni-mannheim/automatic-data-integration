{
  "attribute_rules": {
    "assets": {
      "kwargs": {},
      "resolver": "median"
    },
    "city": {
      "kwargs": {
        "sources": [
          "dbpedia"
        ]
      },
      "resolver": "favour_sources"
    },
    "country": {
      "kwargs": {
        "sources": [
          "forbes"
        ]
      },
      "resolver": "favour_sources"
    },
    "founded": {
      "kwargs": {
        "trust_key": "trust_score"
      },
      "resolver": "prefer_higher_trust"
    },
    "founders": {
      "kwargs": {
        "separator": ","
      },
      "resolver": "union"
    },
    "industry": {
      "kwargs": {},
      "resolver": "most_complete"
    },
    "keypeople_name": {
      "kwargs": {},
      "resolver": "longest_string"
    },
    "name": {
      "kwargs": {},
      "resolver": "longest_string"
    },
    "revenue": {
      "kwargs": {},
      "resolver": "median"
    },
    "website": {
      "kwargs": {},
      "resolver": "most_complete"
    }
  },
  "main_entity": "company/organization"
}